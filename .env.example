# Optional. Keep this server-side only; never place it in browser code or commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Public Sites deployments stay on the grounded fallback unless this is true
# AND a durable PUBLIC_API_RATE_LIMITER Worker binding is configured.
ENABLE_PUBLIC_AI=false

# Optional. One service key can be reused only after each data.go.kr API is approved.
DATA_GO_KR_API_KEY=

# Enable only after applying for 한국철도공사_열차운행정보 (data.go.kr 15125762).
KORAIL_OPEN_API_ENABLED=false

# Optional TourAPI-specific key. If empty, DATA_GO_KR_API_KEY is used.
TOUR_API_KEY=

# Optional in local development: if empty, runtime/validation/token-secret is generated with mode 0600.
# Set a stable 32+ character secret in deployment so anonymous journey tokens survive restarts.
CHAKCHAK_VALIDATION_SECRET=
CHAKCHAK_VALIDATION_STORE=runtime/validation/journeys.json

# P2-B field pilot. Keep the admin key server-side and set 32+ random characters in deployment.
# If empty locally, runtime/validation/admin-secret is generated with mode 0600.
CHAKCHAK_PILOT_ADMIN_KEY=
CHAKCHAK_PILOT_REQUIRE_INVITE=true

# Use 127.0.0.1 locally. Bind 0.0.0.0 only behind an authenticated HTTPS reverse proxy.
HOST=127.0.0.1

# Enable only when that proxy overwrites X-Forwarded-For with a trusted client address.
TRUST_PROXY=false

PORT=4173
